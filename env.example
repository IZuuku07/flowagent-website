# Copy to .env.local. Never commit actual credentials.
HOST=127.0.0.1
PORT=4180
BASE_URL=http://localhost:4180
FLOWAGENT_LOCAL_STUDIO=1
# Use a long random secret shared only with the n8n worker credential.
FLOWAGENT_WORKER_TOKEN=
KIE_API_KEY=
REPLICATE_API_TOKEN=
# In production: FLOWAGENT_LOCAL_STUDIO=0, set BASE_URL to your HTTPS domain,
# configure the existing ADMIN_* and SESSION_SECRET settings, and bind HOST
# appropriately behind your reverse proxy. Use one app process and persistent disk.

# Free remote persistence (server-side only). Configure both values in Render.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role JWT key is also supported as SUPABASE_SERVICE_ROLE_KEY.
